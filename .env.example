# Copy to .env.local and replace placeholders. Never commit real credentials here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SITE_URL=http://localhost:3000

# Day 8: server-only controlled beta. Keep false until migration + quota setup.
AI_WRITING_ENABLED=false
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-3.1-flash-lite
# Supabase service_role key (or server secret key). Never use NEXT_PUBLIC here.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
# Allowances live in public.ai_limits; shared daily attempt cap defaults to 0.
